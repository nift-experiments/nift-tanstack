{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "bun", "node"]
  },
  "include": ["app/src", "shared", "tools", "app/vite.config.ts"],
  "exclude": ["baseline-62", "node_modules"]
}
