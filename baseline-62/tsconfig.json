{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "shared", "vite.config.ts"],
  "exclude": ["control", "node_modules", "evaluation"]
}
